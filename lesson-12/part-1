<!DOCTYPE html>
<html lang="uk" class="h-full w-full overflow-hidden">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Електричний струм у вакуумі — Інтерактивні флеш-картки</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- KaTeX CDN for mathematical & physical formulas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.body);"></script>

    <!-- Font Awesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        
        * {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* 3D Card Flip styles */
        .perspective-1000 {
            perspective: 1000px;
        }
        
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .flipped {
            transform: rotateY(180deg);
        }
        
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(51, 65, 85, 0.8);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(71, 85, 105, 1);
        }

        /* Pulse glow animation for buttons */
        @keyframes subtlePulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(0.98); }
        }
        .pulse-active {
            animation: subtlePulse 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="h-full w-full bg-slate-950 text-slate-100 flex flex-col justify-between overflow-hidden select-none">

    <!-- App Header -->
    <header class="w-full bg-slate-900/90 border-b border-slate-800 px-3 sm:px-5 py-3 flex items-center justify-between z-20 shrink-0 shadow-lg">
        <div class="flex items-center space-x-3">
            <div class="p-2 bg-indigo-600/20 text-indigo-400 rounded-xl border border-indigo-500/30">
                <i class="fa-solid fa-bolt text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-base sm:text-lg md:text-xl text-white tracking-wide leading-tight">
                    Електричний струм у вакуумі
                </h1>
                <p class="text-xs text-slate-400 hidden sm:block">Фізика 9 клас • Електровакуумні прилади</p>
            </div>
        </div>

        <!-- Header Actions -->
        <div class="flex items-center space-x-2">
            <!-- Mode Selector -->
            <div class="bg-slate-800 p-1 rounded-xl flex border border-slate-700/60 text-xs sm:text-sm">
                <button id="btn-mode-card" onclick="setMode('card')" class="px-2.5 py-1.5 rounded-lg font-medium transition-all bg-indigo-600 text-white shadow">
                    <i class="fa-solid fa-clone mr-1"></i><span class="hidden xs:inline">Картка</span>
                </button>
                <button id="btn-mode-quiz" onclick="setMode('quiz')" class="px-2.5 py-1.5 rounded-lg font-medium transition-all text-slate-400 hover:text-white">
                    <i class="fa-solid fa-list-check mr-1"></i><span class="hidden xs:inline">Самоперевірка</span>
                </button>
                <button id="btn-mode-all" onclick="setMode('all')" class="px-2.5 py-1.5 rounded-lg font-medium transition-all text-slate-400 hover:text-white">
                    <i class="fa-solid fa-border-all mr-1"></i><span class="hidden xs:inline">Усі</span>
                </button>
            </div>

            <!-- Fullscreen Button -->
            <button onclick="toggleFullscreen()" class="p-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 rounded-xl transition text-sm flex items-center justify-center" title="Повний екран (F)">
                <i class="fa-solid fa-expand text-base" id="fullscreen-icon"></i>
            </button>
        </div>
    </header>

    <!-- Main Interactive Card View -->
    <main id="main-card-view" class="flex-1 w-full flex flex-col justify-between items-center p-3 sm:p-6 overflow-hidden relative">
        
        <!-- Progress Bar & Navigation Header -->
        <div class="w-full max-w-4xl flex items-center justify-between px-1 mb-2 shrink-0">
            <div class="flex items-center space-x-2">
                <span id="card-counter" class="text-xs sm:text-sm font-semibold text-indigo-400 bg-indigo-950/60 border border-indigo-800/50 px-3 py-1 rounded-full">
                    Картка 1 / 20
                </span>
                <span id="quiz-badge" class="hidden text-xs font-semibold px-2.5 py-1 rounded-full border"></span>
            </div>
            
            <div class="flex items-center space-x-2">
                <button onclick="shuffleCards()" class="text-xs sm:text-sm text-slate-400 hover:text-indigo-300 transition flex items-center gap-1.5 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg">
                    <i class="fa-solid fa-shuffle"></i>
                    <span class="hidden sm:inline">Перемішати</span>
                </button>
                <button onclick="resetProgress()" class="text-xs sm:text-sm text-slate-400 hover:text-rose-300 transition flex items-center gap-1.5 bg-slate-900 border border-slate-800 px-3 py-1 rounded-lg">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span class="hidden sm:inline">Скинути</span>
                </button>
            </div>
        </div>

        <!-- Progress Line -->
        <div class="w-full max-w-4xl bg-slate-800/80 rounded-full h-1.5 mb-2 overflow-hidden shrink-0 border border-slate-700/50">
            <div id="progress-bar" class="bg-gradient-to-r from-indigo-500 to-cyan-400 h-full transition-all duration-300 w-0"></div>
        </div>

        <!-- Center Interactive Card -->
        <div class="flex-1 w-full max-w-4xl my-auto flex items-center justify-center perspective-1000 relative min-h-[280px]">
            <div id="flashcard" onclick="flipCard()" class="w-full h-full max-h-[500px] cursor-pointer relative transform-style-3d group">
                
                <!-- CARD FRONT -->
                <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 border-2 border-slate-700/80 group-hover:border-indigo-500/60 rounded-3xl p-6 sm:p-10 flex flex-col justify-between items-center text-center shadow-2xl backface-hidden transition-all duration-300">
                    <!-- Top Indicator Front -->
                    <div class="w-full flex justify-between items-center text-slate-400 text-xs sm:text-sm font-medium tracking-wide border-b border-slate-800/80 pb-3">
                        <span class="flex items-center gap-2 text-indigo-400 font-semibold">
                            <i class="fa-solid fa-circle-question"></i> ПОНЯТТЯ / ПИТАННЯ
                        </span>
                        <span class="text-slate-500"><i class="fa-solid fa-hand-pointer mr-1"></i> Клацніть для відповіді</span>
                    </div>

                    <!-- Center Question Text -->
                    <div class="my-auto flex items-center justify-center py-4 px-2">
                        <div id="card-front-text" class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white leading-relaxed tracking-tight">
                            Завантаження...
                        </div>
                    </div>
                </div>

                <!-- CARD BACK -->
                <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-indigo-950 via-slate-900 to-slate-900 border-2 border-indigo-500/80 rounded-3xl p-6 sm:p-10 flex flex-col justify-between items-center text-center shadow-2xl backface-hidden rotate-y-180 transition-all duration-300">
                    <!-- Top Indicator Back -->
                    <div class="w-full flex justify-between items-center text-slate-400 text-xs sm:text-sm font-medium tracking-wide border-b border-indigo-900/60 pb-3">
                        <span class="flex items-center gap-2 text-emerald-400 font-semibold">
                            <i class="fa-solid fa-check-circle"></i> ВІДПОВІДЬ / ПОЯСНЕННЯ
                        </span>
                        <span class="text-slate-400"><i class="fa-solid fa-graduation-cap mr-1"></i> Матеріал підручника</span>
                    </div>

                    <!-- Center Answer Text -->
                    <div class="my-auto flex items-center justify-center py-4 px-2">
                        <div id="card-back-text" class="text-lg sm:text-xl md:text-2xl font-semibold text-emerald-100 leading-relaxed">
                            Завантаження...
                        </div>
                    </div>

                    <!-- Bottom Back Hint -->
                    <div class="text-xs sm:text-sm text-indigo-200/70 bg-indigo-900/40 px-4 py-2 rounded-xl border border-indigo-700/40">
                        <i class="fa-solid fa-shield-halved mr-1 text-emerald-400"></i> Точне поняття з курсу фізики
                    </div>
                </div>

            </div>
        </div>

        <!-- Quiz Self-Evaluation Bar (Visible in Quiz mode after flipping) -->
        <div id="quiz-eval-bar" class="w-full max-w-2xl hidden my-2 grid-cols-2 gap-3 shrink-0">
            <button onclick="markCard(false)" class="py-3 px-4 bg-rose-600/20 hover:bg-rose-600/30 border border-rose-500/50 text-rose-300 rounded-2xl font-semibold flex items-center justify-center gap-2 transition active:scale-95">
                <i class="fa-solid fa-xmark text-lg"></i>
                <span>Потрібно повторити</span>
            </button>
            <button onclick="markCard(true)" class="py-3 px-4 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/50 text-emerald-300 rounded-2xl font-semibold flex items-center justify-center gap-2 transition active:scale-95">
                <i class="fa-solid fa-check text-lg"></i>
                <span>Засвоєно!</span>
            </button>
        </div>

        <!-- Bottom Navigation Controls -->
        <div class="w-full max-w-4xl flex items-center justify-between gap-3 mt-2 shrink-0">
            <button onclick="prevCard()" class="flex-1 sm:flex-initial px-5 py-3 bg-slate-800 hover:bg-slate-700 active:bg-slate-900 border border-slate-700 text-slate-200 rounded-2xl font-semibold transition flex items-center justify-center gap-2 shadow-lg">
                <i class="fa-solid fa-arrow-left"></i>
                <span class="hidden sm:inline">Назад</span>
            </button>

            <button onclick="flipCard()" class="flex-1 sm:flex-initial px-6 py-3 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white rounded-2xl font-bold transition flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30">
                <i class="fa-solid fa-rotate"></i>
                <span>Перевернути</span>
            </button>

            <button onclick="nextCard()" class="flex-1 sm:flex-initial px-5 py-3 bg-slate-800 hover:bg-slate-700 active:bg-slate-900 border border-slate-700 text-slate-200 rounded-2xl font-semibold transition flex items-center justify-center gap-2 shadow-lg">
                <span class="hidden sm:inline">Вперед</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <!-- Keyboard Controls Help -->
        <div class="hidden md:flex items-center justify-center gap-4 text-xs text-slate-500 mt-2">
            <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-400">←</kbd> <kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-400">→</kbd> Навігація</span>
            <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-400">Пробіл</kbd> Перевернути</span>
            <span><kbd class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-slate-400">F</kbd> Повний екран</span>
            <span><i class="fa-solid fa-hand-pointer ml-2 mr-1"></i> Свайп ліворуч/праворуч на мобільному</span>
        </div>
    </main>

    <!-- Grid View Mode (All Cards Grid) -->
    <section id="all-cards-view" class="hidden flex-1 w-full overflow-y-auto p-4 sm:p-8 max-w-6xl mx-auto">
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h2 class="text-xl font-bold text-white">Усі картки розділу</h2>
                <p class="text-xs sm:text-sm text-slate-400">Натисніть на картку в списку, щоб відкрити її в режимі вивчення</p>
            </div>
            <div id="stats-summary" class="text-xs sm:text-sm bg-slate-900 px-4 py-2 rounded-xl border border-slate-800 text-slate-300">
                Засвоєно картки: <span id="mastered-count" class="font-bold text-emerald-400">0</span> / <span id="total-grid-count">20</span>
            </div>
        </div>

        <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-12">
            <!-- Dynamically populated -->
        </div>
    </section>

    <script>
        const rawFlashcards = [
            { id: 1, front: "Що таке вакуум?", back: "Простір, майже повністю позбавлений речовини, у якому тиск нижчий за атмосферний." },
            { id: 2, front: "Що називають глибоким (високим) вакуумом?", back: "Стан газу, за якого довжина вільного пробігу його молекул більша за лінійні розміри ємності." },
            { id: 3, front: "Чому у вакуумі неможлива йонна провідність?", back: "Через практично повну відсутність молекул газу для утворення йонного струму." },
            { id: 4, front: "Що є носіями електричного заряду у вакуумі?", back: "Вільні електрони, отримані внаслідок електронної емісії." },
            { id: 5, front: "Яка сила утримує електрони всередині металу?", back: "Кулонівське притягання з боку позитивних йонів кристалічної ґратки." },
            { id: 6, front: "Яка умова необхідна для виходу електронів з поверхні металу?", back: "Передача електронам додаткової енергії (наприклад, через нагрівання) для збільшення їхньої кінетичної енергії." },
            { id: 7, front: "Що таке термоелектронна емісія?", back: "Процес випромінювання електронів нагрітими тілами." },
            { id: 8, front: "Які електрони називають термоелектронами?", back: "Електрони, які вилетили з поверхні металу в процесі термоелектронної емісії." },
            { id: 9, front: "Що являє собою електричний струм у вакуумі?", back: "Напрямлений рух вільних електронів, отриманих унаслідок електронної емісії." },
            { id: 10, front: "Що таке вакуумний діод та з чого він складається?", back: "Електронно-вакуумний пристрій, що складається зі відкачаного скляного балона та двох електродів (анода і підігрівного катода)." },
            { id: 11, front: "Які два основні електроди має вакуумний діод?", back: "Катод (підігрівний, емітує електрони) та анод (приймає електрони)." },
            { id: 12, front: "У чому полягає головна властивість вакуумного діода?", back: "Однобічна провідність (пропускає електричний струм лише в одному напрямку)." },
            { id: 13, front: "Як здійснюється пряме ввімкнення вакуумного діода?", back: "Підключення катода до негативного полюса джерела живлення, а анода — до позитивного." },
            { id: 14, front: "Яким є стан кола при прямому ввімкненні діода?", back: "Коло замкнене, у колі існує електричний струм." },
            { id: 15, front: "Як здійснюється зворотне ввімкнення вакуумного діода?", back: "Підключення катода до позитивного полюса джерела живлення, а анода — до негативного." },
            { id: 16, front: "Яким є стан кола при зворотному ввімкненні діода?", back: "Коло розімкнене, електричний струм відсутній." },
            { id: 17, front: "Що таке рентгенівська трубка?", back: "Електровакуумний пристрій для отримання рентгенівського випромінювання шляхом гальмування швидких електронів." },
            { id: 18, front: "Який принцип утворення променів у рентгенівській трубці?", back: "Розганяння електронів потужним електричним полем та їхнє різке гальмування під час зіткнення з перешкодою." },
            { id: 19, front: "Для чого застосовують рентгенівську трубку в медицині?", back: "Для діагностування захворювань та отримання зображень кісток і внутрішніх органів." },
            { id: 20, front: "Що таке електронно-променева трубка та який принцип її дії?", back: "Електровакуумний пристрій, дія якого ґрунтується на створенні та керуванні вузьким пучком електронів у вакуумі." }
        ];

        let cards = [...rawFlashcards];
        let currentIndex = 0;
        let isFlipped = false;
        let cardStatus = {};
        let currentMode = 'card';

        function playFlipSound() {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(320, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(140, ctx.currentTime + 0.07);
                gain.gain.setValueAtTime(0.12, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.07);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.07);
            } catch (e) {
                // Ignore audio context errors if sound is restricted
            }
        }

        function renderCard() {
            if (cards.length === 0) return;

            const card = cards[currentIndex];
            const frontEl = document.getElementById('card-front-text');
            const backEl = document.getElementById('card-back-text');
            const counterEl = document.getElementById('card-counter');
            const progressBar = document.getElementById('progress-bar');
            const flashcardEl = document.getElementById('flashcard');

            // Reset flip state
            if (isFlipped) {
                isFlipped = false;
                flashcardEl.classList.remove('flipped');
            }

            // Populate Text
            frontEl.innerHTML = card.front;
            backEl.innerHTML = card.back;

            // Render LaTeX formulas if KaTeX is present
            if (window.renderMathInElement) {
                renderMathInElement(frontEl, { delimiters: [{left: '$', right: '$', display: false}] });
                renderMathInElement(backEl, { delimiters: [{left: '$', right: '$', display: false}] });
            }

            // Counter and Progress Bar
            counterEl.textContent = `Картка ${currentIndex + 1} / ${cards.length}`;
            const progressPercent = ((currentIndex + 1) / cards.length) * 100;
            progressBar.style.width = `${progressPercent}%`;

            // Quiz Badge
            const quizBadge = document.getElementById('quiz-badge');
            const evalBar = document.getElementById('quiz-eval-bar');

            if (currentMode === 'quiz') {
                quizBadge.classList.remove('hidden');
                if (cardStatus[card.id] === true) {
                    quizBadge.textContent = "Засвоєно ✓";
                    quizBadge.className = "text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-700/60";
                } else if (cardStatus[card.id] === false) {
                    quizBadge.textContent = "На повторення ✕";
                    quizBadge.className = "text-xs font-semibold px-2.5 py-1 rounded-full bg-rose-950/80 text-rose-400 border border-rose-700/60";
                } else {
                    quizBadge.textContent = "Не оцінено";
                    quizBadge.className = "text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-800 text-slate-400 border border-slate-700";
                }

                if (isFlipped) {
                    evalBar.classList.remove('hidden');
                    evalBar.classList.add('grid');
                } else {
                    evalBar.classList.add('hidden');
                    evalBar.classList.remove('grid');
                }
            } else {
                quizBadge.classList.add('hidden');
                evalBar.classList.add('hidden');
                evalBar.classList.remove('grid');
            }
        }

        function flipCard() {
            const flashcardEl = document.getElementById('flashcard');
            isFlipped = !isFlipped;
            flashcardEl.classList.toggle('flipped', isFlipped);
            playFlipSound();

            if (currentMode === 'quiz') {
                const evalBar = document.getElementById('quiz-eval-bar');
                if (isFlipped) {
                    evalBar.classList.remove('hidden');
                    evalBar.classList.add('grid');
                } else {
                    evalBar.classList.add('hidden');
                    evalBar.classList.remove('grid');
                }
            }
        }

        function nextCard() {
            if (currentIndex < cards.length - 1) {
                currentIndex++;
            } else {
                currentIndex = 0;
            }
            renderCard();
        }

        function prevCard() {
            if (currentIndex > 0) {
                currentIndex--;
            } else {
                currentIndex = cards.length - 1;
            }
            renderCard();
        }

        function shuffleCards() {
            cards.sort(() => Math.random() - 0.5);
            currentIndex = 0;
            renderCard();
            renderAllCardsGrid();
        }

        function resetProgress() {
            cards = [...rawFlashcards];
            currentIndex = 0;
            cardStatus = {};
            renderCard();
            renderAllCardsGrid();
        }

        function markCard(mastered) {
            const currentCard = cards[currentIndex];
            cardStatus[currentCard.id] = mastered;
            renderCard();
            renderAllCardsGrid();
            
            setTimeout(() => {
                nextCard();
            }, 250);
        }

        function setMode(mode) {
            currentMode = mode;

            const btnCard = document.getElementById('btn-mode-card');
            const btnQuiz = document.getElementById('btn-mode-quiz');
            const btnAll = document.getElementById('btn-mode-all');

            const mainView = document.getElementById('main-card-view');
            const allView = document.getElementById('all-cards-view');

            [btnCard, btnQuiz, btnAll].forEach(btn => {
                btn.className = "px-2.5 py-1.5 rounded-lg font-medium transition-all text-slate-400 hover:text-white";
            });

            if (mode === 'card') {
                btnCard.className = "px-2.5 py-1.5 rounded-lg font-medium transition-all bg-indigo-600 text-white shadow";
                mainView.classList.remove('hidden');
                allView.classList.add('hidden');
                renderCard();
            } else if (mode === 'quiz') {
                btnQuiz.className = "px-2.5 py-1.5 rounded-lg font-medium transition-all bg-indigo-600 text-white shadow";
                mainView.classList.remove('hidden');
                allView.classList.add('hidden');
                renderCard();
            } else if (mode === 'all') {
                btnAll.className = "px-2.5 py-1.5 rounded-lg font-medium transition-all bg-indigo-600 text-white shadow";
                mainView.classList.add('hidden');
                allView.classList.remove('hidden');
                renderAllCardsGrid();
            }
        }

        function renderAllCardsGrid() {
            const gridContainer = document.getElementById('cards-grid');
            gridContainer.innerHTML = '';

            let masteredCount = 0;

            rawFlashcards.forEach((card, index) => {
                const isMastered = cardStatus[card.id] === true;
                if (isMastered) masteredCount++;

                const cardEl = document.createElement('div');
                cardEl.className = "bg-slate-900 border border-slate-800 hover:border-indigo-500/50 rounded-2xl p-5 flex flex-col justify-between transition shadow-md group cursor-pointer";
                
                cardEl.innerHTML = `
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <span class="text-xs font-bold text-indigo-400 bg-indigo-950/80 px-2.5 py-0.5 rounded-full border border-indigo-800/40">Картка #${index + 1}</span>
                            ${isMastered ? '<span class="text-xs font-semibold text-emerald-400"><i class="fa-solid fa-circle-check mr-1"></i>Засвоєно</span>' : ''}
                        </div>
                        <h3 class="text-base font-bold text-white mb-2 group-hover:text-indigo-300 transition">${card.front}</h3>
                        <div class="text-sm text-slate-300 border-t border-slate-800/80 pt-3 leading-relaxed">
                            ${card.back}
                        </div>
                    </div>
                `;

                cardEl.onclick = () => {
                    const foundIndex = cards.findIndex(c => c.id === card.id);
                    if (foundIndex !== -1) {
                        currentIndex = foundIndex;
                    }
                    setMode('card');
                };

                gridContainer.appendChild(cardEl);
            });

            document.getElementById('mastered-count').textContent = masteredCount;
            document.getElementById('total-grid-count').textContent = rawFlashcards.length;

            if (window.renderMathInElement) {
                renderMathInElement(gridContainer, {
                    delimiters: [{left: '$', right: '$', display: false}]
                });
            }
        }

        function toggleFullscreen() {
            const icon = document.getElementById('fullscreen-icon');
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().then(() => {
                    icon.className = "fa-solid fa-compress text-base";
                }).catch(err => {
                    console.log(`Fullscreen error: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().then(() => {
                        icon.className = "fa-solid fa-expand text-base";
                    });
                }
            }
        }

        // Keyboard Controls
        document.addEventListener('keydown', (e) => {
            if (currentMode === 'all') return;

            if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown') {
                e.preventDefault();
                flipCard();
            } else if (e.code === 'ArrowRight') {
                e.preventDefault();
                nextCard();
            } else if (e.code === 'ArrowLeft') {
                e.preventDefault();
                prevCard();
            } else if (e.code === 'KeyF') {
                e.preventDefault();
                toggleFullscreen();
            }
        });

        // Touch Swipe & Tap Gestures for Mobile
        let touchStartX = 0;
        let touchStartY = 0;

        const mainArea = document.getElementById('flashcard');

        mainArea.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
        }, { passive: true });

        mainArea.addEventListener('touchend', (e) => {
            const touchEndX = e.changedTouches[0].screenX;
            const touchEndY = e.changedTouches[0].screenY;
            
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;

            // Swipe Horizontal
            if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
                if (diffX < 0) {
                    nextCard();
                } else {
                    prevCard();
                }
            } 
            // Vertical Swipe / Tap to Flip
            else if (Math.abs(diffY) > 45 && Math.abs(diffY) > Math.abs(diffX)) {
                flipCard();
            }
        }, { passive: true });

        // Initialize App
        window.onload = function() {
            renderCard();
        };
    </script>
</body>
</html>
